# Copy to `.env` (repo root of faceless-shorts/) and fill in real values.
# Never commit the real .env — see .gitignore.

# --- Pipeline behavior -------------------------------------------------
REQUIRE_REVIEW=true
UPLOAD_VISIBILITY=private

# --- Stage 1: script generation ----------------------------------------
# claude_code | ollama
LLM_BACKEND=claude_code
# Only needed when LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Only needed in CI (claude setup-token); local dev uses the logged-in CLI session
CLAUDE_CODE_OAUTH_TOKEN=

# --- Stage 2: voice ------------------------------------------------------
# kokoro | edge_tts
TTS_BACKEND=kokoro
EDGE_TTS_VOICE=en-US-AndrewNeural
# Only needed when TTS_BACKEND=kokoro — download from
# https://github.com/thewh1teagle/kokoro-onnx/releases/tag/model-files-v1.0
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin
KOKORO_VOICE=am_adam

# --- Stage 2: facts-template visuals -------------------------------------
# stock | pollinations | local_sd
FACTS_VISUAL_SOURCE=stock
PEXELS_API_KEY=

# --- Stage 3: YouTube upload (Phase 8 — confirm scopes before using) -----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
