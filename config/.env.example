# Copy to `.env` (repo root of faceless-shorts/) and fill in real values.
# Never commit the real .env — see .gitignore.

# --- Pipeline behavior -------------------------------------------------
REQUIRE_REVIEW=true
UPLOAD_VISIBILITY=private

# --- Stage 1: script generation ----------------------------------------
# claude_code | ollama | groq
LLM_BACKEND=claude_code
# Only needed when LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Only needed in CI (claude setup-token); local dev uses the logged-in CLI session
CLAUDE_CODE_OAUTH_TOKEN=

# When LLM_BACKEND=claude_code hits the account's daily/session usage
# limit, call_llm() automatically retries that one call on this backend
# instead of failing the video outright. Leave blank to disable (a
# usage-limit hit just fails normally). "groq" is the only fallback that
# works unattended in CI (a plain hosted API, free tier, no credit card)
# -- ollama needs a locally-running model server this project's CI
# runner doesn't have, so it's only a real fallback option for local dev.
LLM_FALLBACK_BACKEND=
# Free tier signup: https://console.groq.com — only needed if
# LLM_BACKEND, LLM_FALLBACK_BACKEND, or BULK_LLM_BACKEND is groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Metadata (title/description/tags) and the CTA comment are mechanical,
# high-volume, low-stakes generation -- every video calls both regardless
# of template -- so call_bulk_llm() defaults them to a cheap backend
# instead of Claude. Deliberately NOT used for the actual script
# draft/review/rewrite loop (still call_llm()/Claude) -- a cheaper model
# there risks more review rejections, i.e. MORE Claude calls, not fewer.
# claude_code | ollama | groq
BULK_LLM_BACKEND=groq

# --- Stage 2: voice ------------------------------------------------------
# kokoro | edge_tts
TTS_BACKEND=kokoro
EDGE_TTS_VOICE=en-US-AndrewNeural
# Only needed when TTS_BACKEND=kokoro — download from
# https://github.com/thewh1teagle/kokoro-onnx/releases/tag/model-files-v1.0
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin
KOKORO_VOICE=am_adam

# --- Stage 2: facts-template visuals -------------------------------------
# stock | pollinations | local_sd
FACTS_VISUAL_SOURCE=stock
PEXELS_API_KEY=

# --- Stage 3: YouTube upload (Phase 8 — confirm scopes before using) -----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
